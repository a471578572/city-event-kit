# Local example. Copy to .env; npm start loads it when present.
# Docker receives settings through -e or --env-file instead.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
BASE_PATH=/event
DATA_DIR=./data

# Keep the generated administrator credential private.
# Do not paste real credentials into this example or commit a filled .env.
